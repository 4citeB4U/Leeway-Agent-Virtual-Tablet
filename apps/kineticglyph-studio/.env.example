# KineticGlyph Studio — Runtime Configuration
# Do not commit real secrets, private keys, or access tokens to source control.

# Server / Local Dev Port
PORT="3000"

# Public Application URL (used for canonical export metadata if hosted)
APP_URL="http://localhost:3000"

# Optional Authorized LeeWay Formula Fabric Base URL (e.g. https://formula.leeway.local/formula/v1)
# When unset, the Formula Fabric adapter fails closed with BLOCKED_NO_VERIFIED_FORMULA_CAPABILITY.
VITE_LEEWAY_FORMULA_FABRIC_URL=""

# Optional Canonical Memory Authority Contract Path
LEEWAY_MEMORY_CONTRACT_PATH="./MEMORY.md"
