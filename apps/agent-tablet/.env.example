# Optional model enhancement. Leave blank unless an authorized model adapter is configured.

# Optional externally reachable application base URL. Leave blank for local-only operation.
APP_URL=

# Optional authorized local LeeWay model-provider endpoint. Leave blank to use deterministic retrieval only.
LEEWAY_TABLET_MODEL_ENDPOINT=

# Optional owner-controlled Pocket ID / OIDC browser session for read-only Workforce telemetry.
# Issuer and all discovered endpoints must be HTTPS unless they are loopback development endpoints.
LEEWAY_MCP_AUTH_ISSUER=
LEEWAY_AGENT_VT_OIDC_CLIENT_ID=
LEEWAY_AGENT_VT_OIDC_REDIRECT_URI=http://127.0.0.1:3200/api/auth/callback
LEEWAY_AGENT_VT_OIDC_SCOPE=openid profile read:runtime
LEEWAY_MCP_AUDIENCE=
LEEWAY_AGENT_VT_COOKIE_SECURE=false

# Optional read-only Runtime Fabric bindings. The caller's scoped bearer is forwarded; no shared
# workforce bearer is stored in this application.
LEEWAY_WORKFORCE_LOCAL_RUNTIME_URL=
LEEWAY_WORKFORCE_MCP_RESOURCE_URL=

# Optional existing Continuum persistence binding for the notepad surface.
LEEWAY_CONTINUUM_API=http://127.0.0.1:4001
LEEWAY_WORKPLANE_CONTROL_TOKEN=
