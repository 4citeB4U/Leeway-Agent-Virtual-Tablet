# LEEWAY CORE — Environment Configuration
# Copy to .env for local configuration. Never commit actual secrets or tokens.

PORT=3000
NODE_ENV=development

# Creator Authority Passcode for Executive Mutations (leave unset for first-run setup claim)
LEEWAY_CREATOR_PASSCODE=

# Canonical LeeWay Formula Source Directory (defaults to ./server/canonical/leeway-formula/v1)
LEEWAY_FORMULA_SOURCE=

# External LeeWay Service Bindings (optional — unbound services remain explicitly UNBOUND)
LEEWAY_RUNTIME_URL=
LEEWAY_DIAGNOSTICS_ORIGIN=
LEEWAY_DIAGNOSTICS_BODY_ID=
LEEWAY_ZITADEL_ISSUER=
LEEWAY_CRM_API_URL=
LEEWAY_CONTINUUM_URL=
LEEWAY_DEVICE_BRIDGE_URL=
LEEWAY_VERITAS_URL=
LEEWAY_RECEIPT_AUTHORITY_URL=
